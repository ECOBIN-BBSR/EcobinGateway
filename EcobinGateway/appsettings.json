
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "seller-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous"
      },
      "seller-route": {
        "ClusterId": "seller-cluster",
        "Match": {
          "Path": "/api/sellers/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "delivery-route": {
        "ClusterId": "delivery-cluster",
        "Match": {
          "Path": "/api/deliveries/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      }
    },
    "Clusters": {
      "seller-cluster": {
        "Destinations": {
          "seller-api": {
            "Address": "http://localhost:5234/"
          }
        }
      },
      "delivery-cluster": {
        "Destinations": {
          "delivery-api": {
            "Address": "http://localhost:5142/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
