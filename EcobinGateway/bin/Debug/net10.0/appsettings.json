{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "seller-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous"
      },
      "seller-route": {
        "ClusterId": "seller-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      }
    },
    "Clusters": {
      "seller-cluster": {
        "Destinations": {
          "seller-api": {
            "Address": "http://localhost:5234/"
          }
        }
      }
    }
  },
  "Jwt": {
    "Key": "wj90Qe7ZP74C/Gt9G/eiNaipw/vwVKwVtI1W5KokO/Q=",
    "Issuer": "EcobinSellerService",
    "Audience": "EcobinClient"
  },
  "AllowedHosts": "*"
}
